# --- Telegram (obligatorio) ---
# Crea un bot con @BotFather y pega el token aquí.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here
# Tu chat_id (habla con @userinfobot para obtenerlo).
TELEGRAM_CHAT_ID=000000000
# Opcional: notificar a más chats, separados por coma.
TELEGRAM_EXTRA_CHAT_IDS=

# --- Filtros de búsqueda DIAN ---
# La devolución/compensación de IVA se atiende por Videoatención (no presencial).
DIAN_TIPO_ATENCION=Videoatención
DIAN_CATEGORIA=Devoluciones
DIAN_SERVICIO=Devolución
DIAN_CIUDAD=Medellín
DIAN_URL=https://agendamiento.dian.gov.co/

# --- Scheduler (L-V) ---
POLL_HOUR=8
POLL_MINUTE=0
TZ=America/Bogota

# --- Operación ---
HEADLESS=true
# only_hits = solo avisa cuando hay cita nueva. always = avisa en cada consulta
# (con o sin citas). Útil temporalmente para confirmar que el bot está vivo.
NOTIFY_MODE=only_hits
STATE_PATH=state/last_availability.json
LOG_LEVEL=INFO
