# Plantilla versionada del .envrc. Cópiala a .envrc (que está en .gitignore) y
# corre `direnv allow`. No pongas secretos aquí ni en .envrc — van en .env.

if [ -d ".venv" ]; then
  # shellcheck disable=SC1091
  source .venv/bin/activate
fi

# Config aislada de GitHub CLI para este proyecto (ajusta el nombre si prefieres).
export GH_CONFIG_DIR="$HOME/.config/gh-dianbot"

# Perfil AWS de la cuenta dedicada ai-platform-arheanja (080891698277), donde
# vive la infra de DIAN-bot desde la migración del 2026-09-18.
export AWS_PROFILE="ai-platform"

if [ -f ".env" ]; then
  dotenv .env
fi
